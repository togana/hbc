{
  "name": "hbc",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "prepare": "panda codegen",
    "dev": "next dev",
    "build": "panda codegen && panda cssgen --outfile src/styled-system/styles.css && next build",
    "start": "next start",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "imagekit": "6.0.0",
    "next": "16.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-virtuoso": "4.17.0"
  },
  "devDependencies": {
    "@pandacss/dev": "1.7.0",
    "@pandacss/preset-base": "1.7.0",
    "@types/node": "24.10.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "10.1.8",
    "npm-run-all": "4.1.5",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0"
  }
}
